{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FCC laboratory material package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "created_at", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "synthetic": {"type": "boolean", "default": false},
    "notes": {"type": "string"},
    "documents": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/document"}}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "request_ids", "title", "kind", "version", "status", "rights", "representation"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,149}$"},
        "request_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["regulation", "guidance", "standard", "manual", "driver", "example", "lab_record", "protocol", "other"]},
        "version": {"type": "string", "minLength": 1},
        "publisher": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["downloaded", "login_required", "purchase_required", "read_only", "not_found", "not_applicable", "unavailable", "superseded"]},
        "representation": {"enum": ["original", "extracted", "ocr", "metadata"]},
        "rights": {"enum": ["public", "licensed_internal", "read_only", "unknown"]},
        "rights_notes": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "download_url": {"type": "string", "format": "uri"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "media_type": {"type": "string", "minLength": 1},
        "model_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "language": {"type": "string"},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "parent_document_id": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "downloaded"}}},
         "then": {"required": ["path", "sha256", "bytes", "media_type", "source_url", "download_url", "retrieved_at"], "properties": {"rights": {"enum": ["public", "licensed_internal", "unknown"]}}},
         "else": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["sha256"]}, {"required": ["bytes"]}]}, "required": ["notes"]}}
      ]
    }
  }
}
